@echo off
chcp 65001 >nul
setlocal

rem 소르베 서버 모듈 설치 (윈도)
rem 마리나라를 끄고, 이 파일을 Marinara-Engine 최상위 폴더에 넣은 뒤 더블클릭하세요.
rem 이 파일은 build-installers.mjs 가 만든다. 손으로 고치지 않는다.

set "SORBET_ENGINE_ROOT=%~dp0"
if not exist "%~dp0package.json" goto wrong_place
if not exist "%~dp0packages\server\src\routes\index.ts" goto wrong_place
where node >nul 2>nul || goto no_node

set "SRB_"
set "SRB_"
set "SRB_"

echo.
echo [소르베] 서버 모듈 설치를 시작합니다.
echo [중요] 실행 중인 마리나라를 완전히 끈 상태에서 실행하세요.
echo.
node -e "const z=require('zlib'),fs=require('fs'),os=require('os'),p=require('path');const f=p.join(os.tmpdir(),'sorbet-install-'+process.pid+'.cjs');fs.writeFileSync(f,z.gunzipSync(Buffer.from(process.env.SRB_P1+process.env.SRB_P2+process.env.SRB_P3,'base64')));try{require(f)}finally{fs.rmSync(f,{force:true})}"
if errorlevel 1 goto install_failed

echo.
echo 설치가 끝났습니다. 마리나라를 다시 빌드하고 켭니다.
echo.
cd /d "%SORBET_ENGINE_ROOT%"
call "%SORBET_ENGINE_ROOT%start.bat" --skip-update
endlocal
goto :eof

:wrong_place
echo [실패] 이 파일을 Marinara-Engine 최상위 폴더(start.bat 이 있는 곳)에 넣은 뒤 실행하세요.
pause
endlocal
exit /b 1

:no_node
echo [실패] node 를 찾지 못했습니다. 마리나라가 돌아가는 컴퓨터인지 확인하세요.
pause
endlocal
exit /b 1

:install_failed
echo.
echo [실패] 설치하지 못했습니다. 위 오류 내용을 확인하세요.
pause
endlocal
exit /b 1
